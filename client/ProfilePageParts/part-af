      );
      return;
    }

    const promo =
      allPromos.find(
        (item) =>
          item.code === code
      );

    if (!promo) {
      showToast(
        "Promo code not found",
        "error"
      );
      return;
    }

    localStorage.setItem(
      "selectedPromoCode",
      promo.code
    );

    window.dispatchEvent(
      new Event("promoChanged")
    );

    showToast(
      `${promo.code} applied`,
      "success"
    );
  };

