import React, { useMemo, useState } from "react";
import {
  Heart,
  Flame,
  Bell,
  ChevronLeft,
  Search,
  Star,
  MapPin,
  Clock,
  Utensils,
  Store,
  Trash2,
} from "lucide-react";
import { useNavigate } from "react-router-dom";

import { useFavourite } from "../../context/FavouriteContext";

const Favourite = () => {
  const navigate = useNavigate();

  const {
    favourites,
    removeItemFavourite,
    removeRestaurantFavourite,
  } = useFavourite();

  const [activeTab, setActiveTab] = useState("items");
  const [search, setSearch] = useState("");

  const favouriteItems = favourites?.items || [];
  const favouriteRestaurants = favourites?.restaurants || [];

  const filteredItems = useMemo(() => {
    const query = search.trim().toLowerCase();

    if (!query) return favouriteItems;

    return favouriteItems.filter((item) =>
      [
        item.name,
        item.category,
        item.restaurantName,
        item.description,
      ]
        .filter(Boolean)
        .some((value) =>
          String(value).toLowerCase().includes(query)
        )
    );
  }, [favouriteItems, search]);

  const filteredRestaurants = useMemo(() => {
    const query = search.trim().toLowerCase();

    if (!query) return favouriteRestaurants;

    return favouriteRestaurants.filter((restaurant) =>
      [
        restaurant.name,
        restaurant.category,
        restaurant.location,
        restaurant.address,
        restaurant.description,
      ]
        .filter(Boolean)
        .some((value) =>
          String(value).toLowerCase().includes(query)
        )
    );
  }, [favouriteRestaurants, search]);

  const handleBack = () => {
    navigate(-1);
  };

  return (
    <div className="min-h-screen bg-gray-50 px-4 pb-28 font-sans">
      <div className="mx-auto max-w-md">

        {/* HEADER */}
        <div className="flex items-center justify-between pb-5 pt-5">
          <button
            onClick={handleBack}
            className="flex h-11 w-11 items-center justify-center rounded-2xl bg-white text-gray-700 shadow-sm transition active:scale-95"
          >
            <ChevronLeft size={21} />
          </button>

          <div className="text-center">
            <h1 className="text-xl font-extrabold text-gray-800">
              Favorite List
            </h1>

            <p className="mt-0.5 text-[10px] font-semibold text-gray-400">
              {favouriteItems.length + favouriteRestaurants.length} favorites
            </p>
          </div>

          <button
            className="flex h-11 w-11 items-center justify-center rounded-2xl bg-white text-gray-700 shadow-sm"
          >
            <Bell size={19} />
          </button>
        </div>

        {/* SEARCH */}
        <div className="relative mb-5">
          <Search
            className="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"
            size={18}
          />

          <input
            type="text"
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="Search favorites..."
            className="w-full rounded-2xl border border-gray-100 bg-white py-3 pl-12 pr-4 text-sm outline-none shadow-sm focus:ring-2 focus:ring-green-500"
          />
        </div>

        {/* TABS */}
        <div className="mb-6 flex rounded-2xl border border-gray-100 bg-white p-1.5 shadow-sm">

          <button
            onClick={() => {
              setActiveTab("items");
              setSearch("");
            }}
            className={`flex-1 rounded-xl py-3 text-sm font-bold transition-all ${
              activeTab === "items"
                ? "bg-green-600 text-white shadow-lg shadow-green-100"
                : "text-gray-400 hover:text-green-600"
            }`}
          >
            Favourite Items
            <span className="ml-1 text-[10px]">
              ({favouriteItems.length})
            </span>
          </button>

          <button
            onClick={() => {
              setActiveTab("restaurants");
              setSearch("");
            }}
            className={`flex-1 rounded-xl py-3 text-sm font-bold transition-all ${
              activeTab === "restaurants"
                ? "bg-green-600 text-white shadow-lg shadow-green-100"
                : "text-gray-400 hover:text-green-600"
            }`}
          >
            Restaurants
            <span className="ml-1 text-[10px]">
              ({favouriteRestaurants.length})
            </span>
          </button>

        </div>

        {/* ================= ITEMS ================= */}

        {activeTab === "items" && (
          <>
            {filteredItems.length === 0 ? (
              <EmptyState
                icon={<Heart size={38} />}
                title={
                  search
                    ? "No matching favorites"
                    : "No Favourite Items"
                }
                description={
                  search
                    ? "Try another search."
                    : "Food you favourite will appear here."
                }
              />
            ) : (
              <div className="grid grid-cols-2 gap-4">

                {filteredItems.map((item) => (

                  <div
                    key={item.id}
                    className="group relative overflow-hidden rounded-[28px] border border-gray-100 bg-white p-3 shadow-md"
                  >

                    {/* REMOVE */}
                    <button
                      onClick={() =>
                        removeItemFavourite(item.id)
                      }
                      className="absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-white/95 text-red-500 shadow-md backdrop-blur-sm transition hover:scale-105"
                      title="Remove from favourites"
                    >
                      <Heart
                        size={17}
                        fill="currentColor"
                      />
                    </button>

                    {/* IMAGE */}
                    <div
                      onClick={() =>
                        navigate(`/food/${item.id}`, {
                          state: {
                            food: item,
                          },
                        })
                      }
                      className="mb-3 h-32 cursor-pointer overflow-hidden rounded-[22px] bg-gray-100"
                    >
                      {item.image ? (
                        <img
                          src={item.image}
                          alt={item.name}
                          className="h-full w-full object-cover transition duration-500 group-hover:scale-110"
                        />
                      ) : (
                        <div className="flex h-full items-center justify-center text-5xl">
                          🍔
                        </div>
                      )}
                    </div>

                    {/* NAME */}
                    <h3 className="truncate px-1 text-[14px] font-extrabold text-gray-800">
                      {item.name || "Food Item"}
                    </h3>

                    {/* RESTAURANT */}
                    {item.restaurantName && (
                      <p className="mt-1 truncate px-1 text-[10px] font-semibold text-gray-400">
                        {item.restaurantName}
                      </p>
                    )}

                    {/* INFO */}
                    <div className="mt-3 flex items-center justify-between px-1">

                      <span className="flex items-center rounded-lg bg-green-50 px-2 py-1 text-[10px] font-extrabold text-green-600">
                        <Flame size={11} className="mr-1" />
                        {item.calories || item.cal || "--"} Kal
                      </span>

                      <span className="text-sm font-black text-green-700">
                        ৳ {item.price ?? "0"}
                      </span>

                    </div>

                    {/* RATING */}
                    <div className="mt-2 flex items-center gap-1 px-1">
                      <Star
                        size={12}
                        className="fill-yellow-400 text-yellow-400"
                      />

                      <span className="text-[10px] font-bold text-gray-500">
                        {item.rating || "4.5"}
                      </span>
                    </div>

                  </div>

                ))}

              </div>
            )}
          </>
        )}

        {/* ================= RESTAURANTS ================= */}

        {activeTab === "restaurants" && (
          <>
            {filteredRestaurants.length === 0 ? (
              <EmptyState
                icon={<Store size={38} />}
                title={
                  search
                    ? "No matching restaurants"
                    : "No Favourite Restaurants"
                }
                description={
                  search
                    ? "Try another search."
                    : "Restaurants you favourite will appear here."
                }
              />
            ) : (
              <div className="space-y-4">

                {filteredRestaurants.map((restaurant) => (

                  <div
                    key={restaurant.id}
                    className="relative overflow-hidden rounded-[28px] border border-gray-100 bg-white shadow-md"
                  >

                    {/* RESTAURANT IMAGE */}
                    <div
                      onClick={() =>
                        navigate(
                          `/restaurants/${restaurant.id}`
                        )
                      }
                      className="h-40 cursor-pointer overflow-hidden bg-orange-50"
                    >
                      {restaurant.image ? (
                        <img
                          src={restaurant.image}
                          alt={restaurant.name}
                          className="h-full w-full object-cover"
                        />
                      ) : (
                        <div className="flex h-full items-center justify-center text-6xl">
                          🍽️
                        </div>
                      )}
                    </div>

                    {/* REMOVE */}
                    <button
                      onClick={() =>
                        removeRestaurantFavourite(
                          restaurant.id
                        )
                      }
                      className="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/95 text-red-500 shadow-lg backdrop-blur-sm transition hover:scale-105"
                      title="Remove from favourites"
                    >
                      <Heart
                        size={18}
                        fill="currentColor"
                      />
                    </button>

                    <div className="p-4">

                      <h3 className="text-lg font-extrabold text-slate-800">
                        {restaurant.name}
                      </h3>

                      {restaurant.description && (
                        <p className="mt-1 line-clamp-2 text-xs text-gray-400">
                          {restaurant.description}
                        </p>
                      )}

                      <div className="mt-4 flex flex-wrap gap-2">

                        <span className="flex items-center gap-1 rounded-full bg-yellow-50 px-3 py-1.5 text-[10px] font-bold text-yellow-600">
                          <Star
                            size={12}
                            fill="currentColor"
                          />
                          {restaurant.rating || "4.5"}
                        </span>

                        {restaurant.deliveryTime && (
                          <span className="flex items-center gap-1 rounded-full bg-green-50 px-3 py-1.5 text-[10px] font-bold text-green-600">
                            <Clock size={12} />
                            {restaurant.deliveryTime}
                          </span>
                        )}

                        {(restaurant.location ||
                          restaurant.address) && (
                          <span className="flex items-center gap-1 rounded-full bg-gray-50 px-3 py-1.5 text-[10px] font-bold text-gray-500">
                            <MapPin size={12} />
                            {restaurant.location ||
                              restaurant.address}
                          </span>
                        )}

                      </div>

                      <button
                        onClick={() =>
                          navigate(
                            `/restaurants/${restaurant.id}`
                          )
                        }
                        className="mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-green-600 py-3 text-xs font-extrabold text-white shadow-lg shadow-green-100 transition active:scale-[0.98]"
                      >
                        <Utensils size={15} />
                        View Menu
                      </button>

                    </div>

                  </div>

                ))}

              </div>
            )}
          </>
        )}

      </div>

      <style>{`
        body {
          overflow-x: hidden;
        }
      `}</style>

    </div>
  );
};

function EmptyState({ icon, title, description }) {
  return (
    <div className="flex flex-col items-center justify-center py-20 text-center">

      <div className="mb-5 flex h-24 w-24 items-center justify-center rounded-full bg-gray-100 text-gray-300">
        {icon}
      </div>

      <h2 className="text-lg font-extrabold text-gray-700">
        {title}
      </h2>

      <p className="mt-2 max-w-[260px] text-xs leading-5 text-gray-400">
        {description}
      </p>

    </div>
  );
}

export default Favourite;
